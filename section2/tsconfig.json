{
    "compilerOptions": {
      "target": "ESNext",       // 컴파일 결과 생성되는 js 버전
      "module": "ESNext",       // 컴파일 결과 생성되는 모듈 시스템 결정
      "outDir": "dist",         // 컴파일 결과 생성되는 js file 위치
      "strict": true,           // 엄격한 타입 검사 여부 설정
      "moduleDetection": "force",    // 모든 ts 파일에 export 키워드 자동 추가해서 격리된 모듈로 취급(독립모듈)

      "skipLibCheck": true,       // undicie-types 오류 제거
    },
    "ts-node": {
      "esm": true             // ts 파일을 즉시 실행할 수 있도록 함
                              // 터미널에 ts-node src/index.ts 하면 됨됨
    },
    "include": ["src"]          // tsc로 컴파일 할 ts 파일의 범위 설정
  }